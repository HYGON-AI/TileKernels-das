+    compiled = tilelang.compile(kernel)
+    exponents = torch.arange(64, dtype=torch.int32, device='cuda') % 21 - 10
+    actual = torch.empty(64, dtype=torch.float32, device='cuda')
+    compiled(exponents, actual)
+    torch.testing.assert_close(actual, torch.exp2(exponents.float()), rtol=0, atol=0)
