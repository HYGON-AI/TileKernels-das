+// Copyright (c) 2026 Hygon Information Technology Co., Ltd.
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cmath>
+#include <tl_templates/hcu/common.h>
+
+namespace tl {
+
+// Select a neighboring representable level using the caller's random bits.
+// Return FP32 so the ordinary numeric conversion can pack the selected level.
+template <int Mantissa>
+TL_DEVICE float stochastic_round_to_float32(float value, uint32_t random_bits,
+                                            int lane) {
+  uint32_t bits = bit_cast<uint32_t>(value);
+  uint32_t magnitude_bits = bits & 0x7fffffffU;
+  if constexpr (Mantissa == 7) {
+    if (magnitude_bits > 0x7f800000U)
+      return bit_cast<float>(bits | 0x00400000U);
+    if (magnitude_bits == 0x7f800000U)
+      return value;
+    uint32_t noise = (random_bits >> ((lane % 2) * 16)) & 0xffffU;
+    return bit_cast<float>((bits + noise) & 0xffff0000U);
+  } else {
+    static_assert(Mantissa == 3 || Mantissa == 1,
+                  "Expected E4M3 or E2M1 mantissa width");
+    constexpr float maximum = Mantissa == 3 ? 448.0f : 6.0f;
+    constexpr uint32_t minimum_exponent = Mantissa == 3 ? 121U : 127U;
+    if (magnitude_bits > 0x7f800000U) {
+      if constexpr (Mantissa == 3)
+        return value;
+      return bit_cast<float>(bit_cast<uint32_t>(maximum) | (bits & 0x80000000U));
+    }
+    float magnitude = fminf(fabsf(value), maximum);
+    uint32_t exponent = (bit_cast<uint32_t>(magnitude) >> 23) & 255U;
+    exponent = exponent < minimum_exponent ? minimum_exponent : exponent;
+    float spacing = bit_cast<float>((exponent - Mantissa) << 23);
+    float noise = float((random_bits >> ((lane % 4) * 8)) & 255U) * (1.0f / 256.0f);
+    float rounded = floorf(magnitude / spacing + noise) * spacing;
+    return bit_cast<float>(bit_cast<uint32_t>(rounded) | (bits & 0x80000000U));
+  }
+}
+
+} // namespace tl
