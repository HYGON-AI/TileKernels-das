+def test_hcu_bf16_reinterpret_narrow_integer_arithmetic():
+    @T.prim_func
+    def kernel(A: T.Tensor((64,), T.int32), B: T.Tensor((64,), T.float32)):
+        with T.Kernel(1, threads=64):
+            i = T.get_thread_binding()
+            B[i] = T.cast(T.reinterpret(T.cast(A[i] + 127, T.uint16) << 7,
+                                       T.bfloat16), T.float32)
