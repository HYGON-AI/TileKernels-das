+@pytest.mark.parametrize("vec", [4, 32])
+def test_hcu_fp4_fragment_cast_and_packed_store(vec):
+    n = 64 * vec
+    @T.prim_func
+    def kernel(A: T.Tensor((n,), T.float32),
+               B: T.Tensor((n,), T.float4_e2m1fn),
+               C: T.Tensor((n,), T.float32)):
+        with T.Kernel(1, threads=64):
+            values = T.alloc_fragment((n,), T.float32)
+            packed = T.alloc_fragment((n,), T.float4_e2m1fn)
+            restored = T.alloc_fragment((n,), T.float32)
+            T.annotate_layout({
+                values: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+                packed: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+                restored: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+            })
+            T.copy(A, values)
+            for i in T.Parallel(n):
+                packed[i] = T.cast(values[i], T.float4_e2m1fn)
+            T.copy(packed, B)
+            for i in T.Parallel(n):
+                restored[i] = T.cast(packed[i], T.float32)
+            T.copy(restored, C)
+
+    compiled = tilelang.compile(kernel)
+    levels = [0., .5, 1., 1.5, 2., 3., 4., 6.,
+              -0., -.5, -1., -1.5, -2., -3., -4., -6.]
+    x = torch.tensor(levels * (n // 16), dtype=torch.float32, device='cuda')
+    packed = torch.empty(n // 2, dtype=torch.uint8, device='cuda')
+    restored = torch.empty_like(x)
+    compiled(x, packed, restored)
+    expected = torch.tensor([i | ((i + 1) << 4) for i in range(0, 16, 2)] * (n // 16),
+                            dtype=torch.uint8, device='cuda')
+    torch.testing.assert_close(packed, expected, rtol=0, atol=0)
+    torch.testing.assert_close(restored, x, rtol=0, atol=0)
+    assert torch.equal(torch.signbit(restored), torch.signbit(x))
