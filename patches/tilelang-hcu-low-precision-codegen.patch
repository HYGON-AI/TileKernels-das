+def test_hcu_float_literals_preserve_bits():
+    @T.prim_func
+    def kernel(A: T.Tensor((64, 4), T.float32), B: T.Tensor((64, 2), T.float64)):
+        with T.Kernel(1, threads=64):
+            i = T.get_thread_binding()
+            A[i, 0] = T.float32(1 / 6)
+            A[i, 1] = T.float32(1 / 4096)
+            A[i, 2] = T.float32(1 / 448)
+            A[i, 3] = T.float32(0.1)
+            B[i, 0] = T.float64(1 / 6)
+            B[i, 1] = T.float64(1 / 7)
+
+    compiled = tilelang.compile(kernel)
+    actual32 = torch.empty((64, 4), dtype=torch.float32, device='cuda')
+    actual64 = torch.empty((64, 2), dtype=torch.float64, device='cuda')
+    compiled(actual32, actual64)
+    expected32 = torch.tensor([1 / 6, 1 / 4096, 1 / 448, 0.1], dtype=torch.float32, device='cuda').expand_as(actual32)
+    expected64 = torch.tensor([1 / 6, 1 / 7], dtype=torch.float64, device='cuda').expand_as(actual64)
+    torch.testing.assert_close(actual32.view(torch.int32), expected32.contiguous().view(torch.int32), rtol=0, atol=0)
+    torch.testing.assert_close(actual64.view(torch.int64), expected64.contiguous().view(torch.int64), rtol=0, atol=0)
+
