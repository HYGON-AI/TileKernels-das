+@pytest.mark.parametrize("index_dtype", ["int32", "int64"])
+def test_hcu_eight_lane_integer_ramp_arithmetic(index_dtype):
+    offset = 2**33 if index_dtype == "int64" else 0
+    @T.prim_func
+    def kernel(B: T.Tensor((512,), index_dtype)):
+        with T.Kernel(1, threads=64):
+            tid = T.get_thread_binding()
+            indices = T.Ramp(tid * 8, 1, 8)
+            values = T.Ramp(T.cast(tid, index_dtype) * 8 + T.cast(offset, index_dtype), T.cast(1, index_dtype), 8)
+            B[indices] = T.Select(values % T.Broadcast(T.cast(7, index_dtype), 8) < T.Broadcast(T.cast(3, index_dtype), 8), values, -values)
+
+    compiled = tilelang.compile(kernel)
+    dtype = getattr(torch, index_dtype)
+    actual = torch.empty(512, dtype=dtype, device='cuda')
+    compiled(actual)
+    indices = torch.arange(512, dtype=dtype, device='cuda') + offset
+    torch.testing.assert_close(actual, torch.where(indices % 7 < 3, indices, -indices), rtol=0, atol=0)
+
