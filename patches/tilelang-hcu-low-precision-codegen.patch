+def test_hcu_fp4_predicated_copy_zero_padding():
+    n = 256
+    @T.prim_func
+    def kernel(A: T.Tensor((128,), T.float4_e2m1fn),
+               B: T.Tensor((n,), T.float32)):
+        with T.Kernel(1, threads=64):
+            shared = T.alloc_shared((n,), T.float4_e2m1fn)
+            T.copy(A[0], shared)
+            for i in T.Parallel(n):
+                B[i] = T.cast(shared[i], T.float32)
+
+    compiled = tilelang.compile(kernel)
+    # 0x22 packs two E2M1 values of +1.0.
+    packed = torch.full((64,), 0x22, dtype=torch.uint8, device='cuda')
+    restored = torch.empty(256, dtype=torch.float32, device='cuda')
+    compiled(packed, restored)
+    expected = torch.cat([torch.ones(128, device='cuda'), torch.zeros(128, device='cuda')])
+    torch.testing.assert_close(restored, expected, rtol=0, atol=0)
