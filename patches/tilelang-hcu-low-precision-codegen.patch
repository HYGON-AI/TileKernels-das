+@pytest.mark.parametrize('vec', [8, 16])
+@pytest.mark.parametrize('value_dtype', ['bfloat16', 'float16'])
+def test_hcu_fp8_low_precision_vector_cast(vec, value_dtype):
+    n = 64 * vec
+
+    @T.prim_func
+    def kernel(A: T.Tensor((n,), value_dtype),
+               B: T.Tensor((n,), T.float8_e4m3fn),
+               C: T.Tensor((n,), value_dtype)):
+        with T.Kernel(1, threads=64):
+            values = T.alloc_fragment((n,), value_dtype)
+            quantized = T.alloc_fragment((n,), T.float8_e4m3fn)
+            restored = T.alloc_fragment((n,), value_dtype)
+            T.annotate_layout({
+                values: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+                quantized: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+                restored: T.Fragment((n,), lambda i: (i // vec, i % vec)),
+            })
+            T.copy(A, values)
+            for i in T.Parallel(n):
+                quantized[i] = T.cast(values[i], T.float8_e4m3fn)
+            T.copy(quantized, B)
+            for i in T.Parallel(n):
+                restored[i] = T.cast(quantized[i], value_dtype)
+            T.copy(restored, C)
+
+    compiled = tilelang.compile(kernel)
+    levels = torch.arange(127, dtype=torch.uint8).view(torch.float8_e4m3fn).float()
+    x = torch.cat([levels, -levels]).repeat((n + 253) // 254)[:n].to('cuda', getattr(torch, value_dtype))
+    quantized = torch.empty(n, dtype=torch.float8_e4m3fn, device='cuda')
+    restored = torch.empty_like(x)
+    compiled(x, quantized, restored)
+    torch.testing.assert_close(quantized.view(torch.uint8), x.to(torch.float8_e4m3fn).view(torch.uint8), rtol=0, atol=0)
+    torch.testing.assert_close(restored, x, rtol=0, atol=0)
+
