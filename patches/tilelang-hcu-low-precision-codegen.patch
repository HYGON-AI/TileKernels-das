+def test_hcu_stochastic_bf16_preserves_subnormals():
+    @T.prim_func
+    def kernel(A: T.Tensor((128,), T.float32), B: T.Tensor((128,), T.bfloat16)):
+        with T.Kernel(1, threads=64):
+            indices = T.Ramp(T.get_thread_binding() * 2, 1, 2)
+            B[indices] = T.cast(A[indices], T.dtype('bfloat16x2'), round='rs', rbits=T.uint32(0xC0004000))
+
+    compiled = tilelang.compile(kernel)
+    # Halfway between BF16 subnormal codes 1 and 2, without FP32 arithmetic.
+    x = torch.full((128,), 0x00018000, dtype=torch.int32, device='cuda').view(torch.float32)
+    actual = torch.empty(128, dtype=torch.bfloat16, device='cuda')
+    compiled(x, actual)
+    expected_bits = torch.tensor([1, 2] * 64, dtype=torch.int16, device='cuda')
+    torch.testing.assert_close(actual.view(torch.int16), expected_bits, rtol=0, atol=0)
