+@pytest.mark.parametrize('fmt', ['bfloat16', 'float8_e4m3fn', 'float4_e2m1fn'])
+def test_hcu_stochastic_cast_known_random_bits(fmt):
+    target_dtype = T.dtype(fmt)
+    vector_dtype = T.dtype(fmt + 'x4')
+
+    @T.prim_func
+    def kernel(A: T.Tensor((256,), T.float32), B: T.Tensor((256,), target_dtype)):
+        with T.Kernel(1, threads=64):
+            indices = T.Ramp(T.get_thread_binding() * 4, 1, 4)
+            B[indices] = T.cast(A[indices], vector_dtype, round='rs', rbits=T.uint32(0xC0804000))
+
+    compiled = tilelang.compile(kernel)
+    if fmt == 'bfloat16':
+        midpoint, upper = 1 + 2**-8, 1 + 2**-7
+        pattern = [1., upper, 1., upper]
+    elif fmt == 'float8_e4m3fn':
+        midpoint, upper = 1 + 2**-4, 1 + 2**-3
+        pattern = [1., 1., upper, upper]
+    else:
+        midpoint, upper = 1.25, 1.5
+        pattern = [1., 1., upper, upper]
+    signs = torch.where(torch.arange(64, device='cuda') % 2 == 0, 1., -1.)
+    x = (torch.full((64, 4), midpoint, device='cuda') * signs[:, None]).reshape(-1)
+    if fmt == 'float4_e2m1fn':
+        actual = torch.empty(128, dtype=torch.uint8, device='cuda')
+        compiled(x, actual)
+        expected = torch.tensor([[0x22, 0x33] if i % 2 == 0 else [0xAA, 0xBB] for i in range(64)],
+                                dtype=torch.uint8, device='cuda').reshape(-1)
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    else:
+        actual = torch.empty(256, dtype=getattr(torch, fmt), device='cuda')
+        compiled(x, actual)
+        expected = (torch.tensor(pattern, device='cuda')[None, :] * signs[:, None]).reshape(-1)
+        torch.testing.assert_close(actual.float(), expected, rtol=0, atol=0)
+
